{"nodes": [{"id": "_claude_skills_eco_elevation_skill_elevation", "label": "Elevation and shadows", "file_type": "concept", "source_file": ".claude/skills/eco-elevation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bigger and softer shadow means higher elevation; use sparingly."}, {"id": "_claude_skills_eco_elevation_skill_shadow_bottom", "label": "Shadow Bottom elevation-b-20 to b-100", "file_type": "concept", "source_file": ".claude/skills/eco-elevation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Most common; b-20 cards/tables, b-40 tooltip, b-60 notification, b-80 header/menu, b-100 modals."}, {"id": "_claude_skills_eco_elevation_skill_shadow_top", "label": "Shadow Top elevation-t-*", "file_type": "concept", "source_file": ".claude/skills/eco-elevation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used sparingly; never mixed with Bottom on one component."}, {"id": "_claude_skills_eco_elevation_skill_designated_level", "label": "Designated Level elevation-drawer-*", "file_type": "concept", "source_file": ".claude/skills/eco-elevation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Global drawers and navigation always use drawer shadows, never elevation-b-*."}, {"id": "_claude_skills_eco_elevation_skill_component_specific", "label": "Component-specific elevation tokens", "file_type": "concept", "source_file": ".claude/skills/eco-elevation/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Switch and table-overflow shadows are never used outside their component."}, {"id": "_claude_skills_eco_elevation_skill_lowest_level_rule", "label": "Always choose lowest possible el