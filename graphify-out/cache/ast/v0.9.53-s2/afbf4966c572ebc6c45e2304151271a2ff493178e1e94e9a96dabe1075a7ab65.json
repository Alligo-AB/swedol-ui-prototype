{"nodes": [{"id": "$graphify-root$_claude_skills_eco_chip_skill_md", "label": "SKILL.md", "file_type": "document", "node_kind": "page", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L1", "frontmatter": {"name": "eco-chip", "description": "Use when building or reviewing a chip \u2014 a small interactive element that represents an input, attribute or action, most often a filter chip the user selects and unselects (toggle button with aria-pressed), or a removable chip (picked value, entered email address). Sizes Medium/Small, optional leading icon, states Enabled/Hover/Selected/Selected hover. Not for a category label (use eco-tag), a non-interactive status (use eco-badge), an action (use eco-button) or a two-view switch (use eco-pill-segment-contro"}}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_chip_eco_design_system", "label": "Chip (ECO Design System)", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L10"}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_when_to_use_not_to_use", "label": "When to use / not to use", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L16"}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_size_model", "label": "Size model", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L23"}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_typography", "label": "Typography", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L32"}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_states", "label": "States", "file_type": "document", "node_kind": "heading", "source_file": ".claude/skills/eco-chip/SKILL.md", "source_location": "L41"}, {"id": "$graphify-root$_claude_skills_eco_chip_skill_html_structure", "label": "HTML struc